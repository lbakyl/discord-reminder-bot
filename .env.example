# --- Discord ---
DISCORD_BOT_TOKEN=
# Optional: set to a server (guild) ID while developing so slash commands
# register instantly there instead of waiting up to ~1hr for global sync.
DISCORD_TEST_GUILD_ID=

# --- Scheduling ---
# IANA timezone used to decide "today" and when the daily check runs.
TIMEZONE=Europe/London
REMINDER_HOUR=8
REMINDER_MINUTE=0
# Default lead times (days before the event) when /event add doesn't specify one.
DEFAULT_ADVANCE_DAYS=7,1,0

# --- Storage ---
DB_PATH=/app/data/reminders.db

# --- Email (optional, only used if SMTP_HOST is set) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=jan.bachelor@gmail.com
# Fill this in directly in your local .env file (never in .env.example, never
# in chat) — a Gmail "App Password", not your normal account password.
SMTP_PASSWORD=
SMTP_FROM=jan.bachelor@gmail.com
